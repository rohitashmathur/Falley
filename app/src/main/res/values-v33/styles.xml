<resources>
    <style name="Theme.Falley" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#17191B</item>
        <item name="android:colorAccent">#5DE0BA</item>
        <item name="android:statusBarColor">#17191B</item>
        <item name="android:navigationBarColor">#17191B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">#17191B</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#17191B</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <!-- Prefer the name/avatar artwork on default-style warm starts as well. -->
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
